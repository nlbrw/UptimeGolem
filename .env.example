# Discord Bot Configuration
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Logging Configuration (set to true only if needed - writes to SD card)
ENABLE_FILE_LOGGING=false

# Minecraft Server Configuration
MINECRAFT_SERVER_IP=127.0.0.1
MINECRAFT_SERVER_PORT=25565
# Optional display name shown in the status card (e.g. Krakenboys SMP)
SERVER_DISPLAY_NAME="Minecraft Server"

# Discord Channel Configuration
VOICE_CHANNEL_ID=0
TEXT_CHANNEL_ID=0
GUILD_ID=0

# Polling and Update Configuration
LAN_POLL_INTERVAL=5
INITIAL_DISCORD_UPDATE_INTERVAL=10
RATE_LIMIT_THRESHOLD=0.5
# Seconds to wait before showing the server as offline
OFFLINE_GRACE_PERIOD=30
